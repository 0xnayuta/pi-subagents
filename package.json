{
  "name": "pi-subagents",
  "version": "0.1.0",
  "description": "Lightweight pi extension for delegating tasks to five specialized readonly agents with depth protection and output sanitization",
  "author": "Izayoi Nayuta",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xnayuta/pi-subagents.git"
  },
  "homepage": "https://github.com/0xnayuta/pi-subagents#readme",
  "bugs": {
    "url": "https://github.com/0xnayuta/pi-subagents/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "subagents",
    "ai",
    "agents",
    "cli"
  ],
  "files": [
    "src/**/*.ts",
    "agents/",
    "README.md",
    "CHANGELOG.md",
    "docs/"
  ],
  "scripts": {
    "test": "pnpm test:unit",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:mvp": "node --experimental-strip-types --test tests/mvp/unit/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "pi": {
    "extensions": [
      "./src/extension/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "^0.74.0",
    "@earendil-works/pi-ai": "^0.74.0",
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "@earendil-works/pi-tui": "^0.74.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "dependencies": {
    "typebox": "^1.1.24"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@earendil-works/pi-agent-core": "^0.74.0",
    "@earendil-works/pi-ai": "^0.74.0",
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "@earendil-works/pi-tui": "^0.74.0",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@11.0.9"
}
